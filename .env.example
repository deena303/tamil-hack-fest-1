# ==============================================================================
# TamilVault AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or relevant subfolder .env files.
# NEVER commit real credentials, secret keys, or service-role keys to Git.

# --- Backend Configuration (backend/.env) ---
# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model preference (e.g. gemini-flash-lite-latest, gemini-2.5-flash)
GEMINI_MODEL=gemini-flash-lite-latest

# Server Host & Port
HOST=127.0.0.1
PORT=8001

# --- Frontend Configuration (frontend/.env) ---
# Backend API Base URL
VITE_API_URL=http://localhost:8001

# Supabase Project Configuration (Publishable/Anon key safe for client-side use)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
