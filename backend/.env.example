# TamilVault AI — Backend Environment Configuration
# Copy to backend/.env and fill in your values.
# NEVER commit backend/.env to Git.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for OCR.
# Recommended: gemini-flash-lite-latest (fastest, lowest latency, vision-capable)
# Alternatives: gemini-flash-latest, gemini-2.5-flash
GEMINI_MODEL=gemini-flash-lite-latest

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001
