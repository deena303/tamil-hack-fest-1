# TamilVault AI — Backend Environment Configuration
# Copy to backend/.env and fill in your values.
# NEVER commit backend/.env to Git.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get a free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for OCR.
# Recommended: gemini-2.0-flash (fast, vision-capable, free tier available)
# Alternatives: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
