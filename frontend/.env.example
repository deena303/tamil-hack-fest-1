# Frontend Environment Variables (Example)
# Copy this file to frontend/.env and customize as needed.
# NEVER commit frontend/.env with secrets to Git.

# Backend API URL
VITE_API_URL=http://localhost:8001

# Supabase Configuration (Publishable/Anon key is safe for browser use)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
